# Порт приложения
PORT=3000

# Подключение к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=museum_db

# Автоматическое создание таблиц (только для учебного проекта)
DB_SYNCHRONIZE=true

# Автозаполнение пустой базы демонстрационными данными
DB_SEED=true
